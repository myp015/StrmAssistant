<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0</TargetFrameworks>
    <AssemblyVersion>2.2.0.0</AssemblyVersion>
    <FileVersion>2.2.0.0</FileVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Tokenizer\linux\libsimple.so" />
    <None Remove="Tokenizer\win\libsimple.so" />
    <None Remove="Web\Resources\strmassistant.js" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Properties\thumb.png" />
    <EmbeddedResource Include="Tokenizer\linux\libsimple.so" />
    <EmbeddedResource Include="Tokenizer\win\libsimple.so" />
    <EmbeddedResource Include="Web\Resources\strmassistant.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CHTCHSConv" Version="1.0.0">
    </PackageReference>
    <PackageReference Include="ILRepack" Version="2.0.42">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
    <PackageReference Include="mediabrowser.server.core" Version="4.9.1.90">
      <!-- 当前支持4.9.1.0及更高版本 -->
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Resource.Embedder" Version="2.2.0" />
    <PackageReference Include="SQLitePCL.pretty.core" Version="1.2.2" />
    <PackageReference Include="TinyPinyin" Version="1.1.0">
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-hant.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup>
    <!-- 可通过 /p:StrmAssistantPluginOutputDir=... 覆盖部署目录 -->
    <StrmAssistantPluginOutputDir Condition="'$(StrmAssistantPluginOutputDir)'=='' and '$(OS)'=='Windows_NT' and '$(APPDATA)'!=''">$(APPDATA)\Emby-Server\programdata\plugins</StrmAssistantPluginOutputDir>
  </PropertyGroup>

  <Target Name="PostBuildMerge" AfterTargets="Build">
    <Message Importance="high" Text="StrmAssistant: ILRepack merge -> $(TargetPath)" />
    <Exec Command="&quot;$(ILRepack)&quot; /out:&quot;$(TargetPath)&quot; &quot;$(TargetPath)&quot; &quot;$(TargetDir)0Harmony.dll&quot; &quot;$(TargetDir)ChineseConverter.dll&quot; &quot;$(TargetDir)TinyPinyin.dll&quot; /lib:&quot;$(TargetDir)&quot;" />

    <MakeDir Condition="'$(StrmAssistantPluginOutputDir)'!=''" Directories="$(StrmAssistantPluginOutputDir)" />
    <Copy Condition="'$(StrmAssistantPluginOutputDir)'!=''"
          SourceFiles="$(TargetPath)"
          DestinationFiles="$(StrmAssistantPluginOutputDir)\$(TargetFileName)"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
    <Message Condition="'$(StrmAssistantPluginOutputDir)'!=''" Importance="high" Text="StrmAssistant: deployed merged plugin -> $(StrmAssistantPluginOutputDir)\$(TargetFileName)" />
    <Message Condition="'$(StrmAssistantPluginOutputDir)'==''" Importance="normal" Text="StrmAssistant: skip auto-deploy (set /p:StrmAssistantPluginOutputDir=... if needed)." />
  </Target>
</Project>
