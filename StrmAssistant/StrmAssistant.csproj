<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0</TargetFrameworks>
    <AssemblyVersion>26.3.25</AssemblyVersion>
    <FileVersion>26.3.25.0</FileVersion>
    <Version>26.3.25</Version>
    <InformationalVersion>26.3.25</InformationalVersion>
    <CopyLocalLockFileAssemblies>True</CopyLocalLockFileAssemblies>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Tokenizer\linux\libsimple.so" />
    <None Remove="Tokenizer\linux-arm64\libsimple.so" />
    <None Remove="Tokenizer\win\libsimple.so" />
    <None Remove="Web\Resources\strmassistant.js" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Properties\thumb.png" />
    <EmbeddedResource Include="Tokenizer\linux\libsimple.so" />
    <EmbeddedResource Include="Tokenizer\linux-arm64\libsimple.so" />
    <EmbeddedResource Include="Tokenizer\win\libsimple.so" />
    <EmbeddedResource Include="Web\Resources\strmassistant.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CHTCHSConv" Version="1.0.0">
    </PackageReference>
    <PackageReference Include="ILRepack" Version="2.0.42">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="mediabrowser.server.core" Version="4.9.1.90">
      <!-- 当前支持4.9.1.0及更高版本 -->
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Resource.Embedder" Version="2.2.0" />
    <PackageReference Include="SQLitePCL.pretty.core" Version="1.2.2" />
    <PackageReference Include="TinyPinyin" Version="1.1.0">
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-hant.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh.resx">
      <DependentUpon>Resources.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup>
    <!-- 可通过 /p:StrmAssistantPluginOutputDir=... 覆盖部署目录 -->
    <StrmAssistantPluginOutputDir Condition="'$(StrmAssistantPluginOutputDir)'=='' and '$(OS)'=='Windows_NT' and '$(APPDATA)'!=''">$(APPDATA)\Emby-Server\programdata\plugins</StrmAssistantPluginOutputDir>

    <!-- 显式拼接输出目录，避免 Build 目标里 TargetPath/TargetDir 为空 -->
    <StrmAssistantBuildOutputDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\</StrmAssistantBuildOutputDir>
    <StrmAssistantMergedAssembly>$(StrmAssistantBuildOutputDir)$(AssemblyName).dll</StrmAssistantMergedAssembly>

    <!-- ILRepack 可执行文件：优先使用 NuGet 包目录，避免 $(ILRepack) 这类空属性 -->
    <ILRepackExe Condition="'$(ILRepackExe)'=='' and '$(NuGetPackageRoot)'!=''">$(NuGetPackageRoot)ilrepack\2.0.42\tools\ILRepack.exe</ILRepackExe>
    <ILRepackExe Condition="'$(ILRepackExe)'=='' and '$(UserProfile)'!=''">$(UserProfile)\.nuget\packages\ilrepack\2.0.42\tools\ILRepack.exe</ILRepackExe>
  </PropertyGroup>

  <Target Name="PostBuildMerge" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <Message Importance="high" Text="StrmAssistant: build output dir -> $(StrmAssistantBuildOutputDir)" />
    <Message Importance="high" Text="StrmAssistant: ILRepack merge -> $(StrmAssistantMergedAssembly)" />
    <Message Importance="high" Text="StrmAssistant: ILRepack exe -> $(ILRepackExe)" />
    <Exec Command="&quot;$(ILRepackExe)&quot; /out:&quot;$(StrmAssistantMergedAssembly)&quot; &quot;$(StrmAssistantMergedAssembly)&quot; &quot;$(StrmAssistantBuildOutputDir)0Harmony.dll&quot; &quot;$(StrmAssistantBuildOutputDir)ChineseConverter.dll&quot; &quot;$(StrmAssistantBuildOutputDir)TinyPinyin.dll&quot; /lib:&quot;$(StrmAssistantBuildOutputDir)&quot;" />

    <MakeDir Condition="'$(StrmAssistantPluginOutputDir)'!=''" Directories="$(StrmAssistantPluginOutputDir)" />
    <Copy Condition="'$(StrmAssistantPluginOutputDir)'!=''"
          SourceFiles="$(StrmAssistantMergedAssembly)"
          DestinationFiles="$(StrmAssistantPluginOutputDir)\$(TargetFileName)"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
    <Message Condition="'$(StrmAssistantPluginOutputDir)'!=''" Importance="high" Text="StrmAssistant: deployed merged plugin -> $(StrmAssistantPluginOutputDir)\$(TargetFileName)" />
    <Message Condition="'$(StrmAssistantPluginOutputDir)'==''" Importance="normal" Text="StrmAssistant: skip auto-deploy (set /p:StrmAssistantPluginOutputDir=... if needed)." />
  </Target>
</Project>
